
uniform bool Jogo_PularCutscenes <
	ui_category = "Ajustes do jogo (valem na proxima vez que abrir o jogo)";
	ui_label = "Pular cutscenes";
	ui_tooltip = "Ligado: as cutscenes sao puladas. Desligado: elas tocam. (SkipMovies)";
> = %SKIP%;

uniform bool Jogo_RastroNitro <
	ui_category = "Ajustes do jogo (valem na proxima vez que abrir o jogo)";
	ui_label = "Rastro do nitro";
	ui_tooltip = "Mostra o rastro de luz das lanternas ao usar o nitro. (NosTrailRepeatCount)";
> = %RASTRO%;
